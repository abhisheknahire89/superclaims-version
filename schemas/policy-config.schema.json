{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aw/schemas/policy-config.schema.json",
  "title": "PolicyConfig",
  "description": "PROPOSED. Versioned, customer-authored configuration of one product's adjudication terms. Published configs are immutable; changes create a new version with four-eyes approval.",
  "type": "object",
  "required": [
    "config_id",
    "config_version",
    "status",
    "product_name",
    "jurisdiction",
    "customer_id",
    "effective_from",
    "currency",
    "authoritative_documents",
    "rounding",
    "sum_insured",
    "room_rent",
    "non_payable",
    "tariff",
    "sub_limits",
    "deductible",
    "co_payment",
    "waiting_periods",
    "pre_post_hospitalisation",
    "calculation_order",
    "clause_refs"
  ],
  "$defs": {
    "money": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$"
    },
    "percent": {
      "type": "string",
      "pattern": "^[0-9]{1,3}(\\.[0-9]+)?$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "config_id": {
      "type": "string",
      "pattern": "^POLCFG-"
    },
    "config_version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "IN_REVIEW",
        "PUBLISHED",
        "RETIRED",
        "ILLUSTRATIVE"
      ]
    },
    "illustrative_notice": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "product_uin": {
      "type": "string"
    },
    "jurisdiction": {
      "const": "IN"
    },
    "customer_id": {
      "type": "string"
    },
    "effective_from": {
      "$ref": "#/$defs/date"
    },
    "effective_to": {
      "anyOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "currency": {
      "const": "INR"
    },
    "authoritative_documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "doc_id",
          "title"
        ]
      }
    },
    "rounding": {
      "type": "object",
      "required": [
        "line_step",
        "final_payable",
        "record_rounding_adjustment"
      ],
      "properties": {
        "line_step": {
          "const": "PAISE_HALF_UP"
        },
        "final_payable": {
          "enum": [
            "RUPEE_HALF_UP",
            "RUPEE_DOWN",
            "PAISE"
          ]
        },
        "record_rounding_adjustment": {
          "const": true
        }
      }
    },
    "sum_insured": {
      "type": "object",
      "required": [
        "basis",
        "cumulative_bonus_counts_toward_available_si",
        "cumulative_bonus_counts_toward_room_rent_base"
      ]
    },
    "room_rent": {
      "type": "object",
      "required": [
        "normal_room_limit",
        "icu_limit",
        "proportionate_deduction",
        "room_day_count"
      ],
      "properties": {
        "normal_room_limit": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "PERCENT_OF_BASE_SI_PER_DAY",
                "FIXED_PER_DAY",
                "ROOM_CATEGORY",
                "NO_LIMIT"
              ]
            },
            "percent": {
              "$ref": "#/$defs/percent"
            }
          }
        },
        "icu_limit": {
          "type": "object",
          "required": [
            "type"
          ]
        },
        "proportionate_deduction": {
          "type": "object",
          "required": [
            "enabled",
            "applies_to_categories",
            "exempt_categories",
            "exempt_ward_contexts",
            "actual_rate_basis"
          ],
          "properties": {
            "actual_rate_basis": {
              "enum": [
                "DAY_WEIGHTED",
                "HIGHEST"
              ]
            }
          }
        },
        "room_day_count": {
          "enum": [
            "MIDNIGHTS",
            "CALENDAR_DAYS"
          ]
        }
      }
    },
    "non_payable": {
      "type": "object",
      "required": [
        "list_ref",
        "list_version",
        "treatment"
      ]
    },
    "tariff": {
      "type": "object",
      "required": [
        "apply_network_tariff_on_reimbursement",
        "on_missing_tariff_item"
      ]
    },
    "sub_limits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "amount"
        ],
        "properties": {
          "amount": {
            "$ref": "#/$defs/money"
          }
        }
      }
    },
    "deductible": {
      "type": "object",
      "required": [
        "amount"
      ],
      "properties": {
        "amount": {
          "$ref": "#/$defs/money"
        }
      }
    },
    "co_payment": {
      "type": "object",
      "required": [
        "rules",
        "base"
      ],
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rule_code",
              "condition",
              "percent"
            ]
          }
        }
      }
    },
    "waiting_periods": {
      "type": "object",
      "required": [
        "initial_days",
        "pre_existing_disease_months",
        "specific_conditions",
        "automation_boundary"
      ],
      "properties": {
        "pre_existing_disease_months": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        }
      }
    },
    "pre_post_hospitalisation": {
      "type": "object",
      "required": [
        "pre_days",
        "post_days"
      ]
    },
    "calculation_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^R-"
      }
    },
    "clause_refs": {
      "type": "object",
      "description": "Authority for every deduction-producing rule: the wording or manual clause that permits it. Engine fails the evaluation if a rule that deducts has no entry.",
      "required": [
        "R-LINE-DUPLICATE",
        "R-LINE-NONPAYABLE",
        "R-LINE-ROOM-CAP",
        "R-LINE-PROPORTIONATE",
        "R-CLAIM-SUBLIMIT",
        "R-CLAIM-DEDUCTIBLE",
        "R-CLAIM-COPAY",
        "R-CLAIM-SI-CAP",
        "R-CLAIM-ROUNDING"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "doc_id",
          "clause"
        ],
        "properties": {
          "doc_id": {
            "type": "string"
          },
          "clause": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
