{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aw/schemas/evaluation-result.schema.json",
  "title": "EvaluationResult",
  "description": "PROPOSED. Output of one deterministic rule run for a claim. Money values are decimal strings in rupees with exactly two decimals; storage uses integer paise.",
  "type": "object",
  "required": [
    "engine_version",
    "claim_id",
    "evaluation_id",
    "config_versions",
    "input_hash",
    "recommendation",
    "lines",
    "adjustments",
    "findings",
    "query_items",
    "rule_executions",
    "output_hash"
  ],
  "additionalProperties": false,
  "$defs": {
    "money": {
      "type": "string",
      "pattern": "^-?[0-9]+\\.[0-9]{2}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidenceRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/docEvidence"
        },
        {
          "$ref": "#/$defs/recordEvidence"
        }
      ]
    },
    "adjustment": {
      "type": "object",
      "required": [
        "adjustment_id",
        "level",
        "line_id",
        "rule_id",
        "rule_version",
        "reason_code",
        "amount",
        "engine_amount",
        "origin",
        "override_ref",
        "base_before",
        "remaining_after",
        "formula",
        "explanation",
        "authority",
        "evidence_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "adjustment_id": {
          "type": "string"
        },
        "level": {
          "enum": [
            "LINE",
            "CLAIM"
          ]
        },
        "line_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "rule_id": {
          "type": "string",
          "pattern": "^R-"
        },
        "rule_version": {
          "type": "string"
        },
        "reason_code": {
          "type": "string"
        },
        "amount": {
          "$ref": "#/$defs/money"
        },
        "base_before": {
          "$ref": "#/$defs/money"
        },
        "remaining_after": {
          "$ref": "#/$defs/money"
        },
        "formula": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          },
          "minItems": 1
        },
        "engine_amount": {
          "$ref": "#/$defs/money"
        },
        "origin": {
          "enum": [
            "ENGINE",
            "REVIEWER_OVERRIDE",
            "REVIEWER_ADDED"
          ]
        },
        "override_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority": {
          "$ref": "#/$defs/authority"
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "finding_id",
        "rule_id",
        "category",
        "kind",
        "severity",
        "blocking",
        "blocked_scopes",
        "summary",
        "uncertainty_note",
        "evidence_refs",
        "route_to",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "type": "string"
        },
        "rule_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "blocked_scopes": {
          "type": "array",
          "items": {
            "enum": [
              "ALL_FINANCIAL",
              "LINE_RULES",
              "ROOM_DAYS",
              "WAITING_PERIOD",
              "PRE_POST_WINDOW"
            ]
          }
        },
        "summary": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "route_to": {
          "enum": [
            "PROCESSOR",
            "MEDICAL_OFFICER",
            "FWA_REVIEW",
            "CRC_REFERRAL_CANDIDATE",
            null
          ]
        },
        "status": {
          "enum": [
            "OPEN",
            "ACKNOWLEDGED",
            "RESOLVED",
            "DISMISSED",
            "SUPERSEDED"
          ]
        },
        "category": {
          "enum": [
            "DOCUMENT",
            "IDENTITY",
            "ELIGIBILITY",
            "FINANCIAL",
            "CLINICAL",
            "ANOMALY"
          ]
        },
        "uncertainty_note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "enum": [
                  "CLINICAL",
                  "ANOMALY"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "uncertainty_note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "docEvidence": {
      "type": "object",
      "required": [
        "document_id",
        "page",
        "quote"
      ],
      "properties": {
        "document_id": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "recordEvidence": {
      "type": "object",
      "required": [
        "record_type",
        "record_id",
        "field"
      ],
      "properties": {
        "record_type": {
          "enum": [
            "MEMBER_RECORD",
            "POLICY_RECORD",
            "CLAIM_RECORD",
            "SI_LEDGER",
            "CONFIG"
          ]
        },
        "record_id": {
          "type": "string"
        },
        "field": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": [
        "artifact",
        "doc_id",
        "clause"
      ],
      "properties": {
        "artifact": {
          "type": "string",
          "pattern": "@"
        },
        "doc_id": {
          "type": "string"
        },
        "clause": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "engine_version": {
      "type": "string"
    },
    "claim_id": {
      "type": "string"
    },
    "evaluation_id": {
      "type": "string"
    },
    "config_versions": {
      "type": "object",
      "required": [
        "policy_config",
        "nme_list",
        "tariff",
        "checklist",
        "engine",
        "rules"
      ],
      "properties": {
        "policy_config": {
          "type": "string",
          "pattern": "@"
        },
        "nme_list": {
          "type": "string",
          "pattern": "@"
        },
        "tariff": {
          "type": [
            "string",
            "null"
          ]
        },
        "rules": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "checklist": {
          "type": [
            "string",
            "null"
          ]
        },
        "engine": {
          "type": "string"
        }
      }
    },
    "input_hash": {
      "$ref": "#/$defs/hash"
    },
    "output_hash": {
      "$ref": "#/$defs/hash"
    },
    "recommendation": {
      "type": "object",
      "required": [
        "type",
        "computed",
        "recommended_payable",
        "billed_total",
        "line_level_deductions",
        "claim_level_deductions",
        "blocked_scopes",
        "human_decision_required"
      ],
      "properties": {
        "type": {
          "enum": [
            "PAY_FULL",
            "PAY_PARTIAL",
            "QUERY",
            "QUERY_AND_REFER_MEDICAL",
            "REFER_MEDICAL",
            "REFER_CRC",
            "INVESTIGATE"
          ]
        },
        "computed": {
          "type": "boolean"
        },
        "recommended_payable": {
          "anyOf": [
            {
              "$ref": "#/$defs/money"
            },
            {
              "type": "null"
            }
          ]
        },
        "billed_total": {
          "$ref": "#/$defs/money"
        },
        "bill_stated_total": {
          "type": [
            "string",
            "null"
          ]
        },
        "itemised_lines_available": {
          "type": "boolean"
        },
        "line_level_deductions": {
          "$ref": "#/$defs/money"
        },
        "claim_level_deductions": {
          "$ref": "#/$defs/money"
        },
        "admissible_after_line_rules": {
          "anyOf": [
            {
              "$ref": "#/$defs/money"
            },
            {
              "type": "null"
            }
          ]
        },
        "blocked_scopes": {
          "type": "array",
          "items": {
            "enum": [
              "ALL_FINANCIAL",
              "LINE_RULES",
              "ROOM_DAYS",
              "WAITING_PERIOD",
              "PRE_POST_WINDOW"
            ]
          }
        },
        "human_decision_required": {
          "const": true
        }
      },
      "if": {
        "properties": {
          "computed": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "recommended_payable": {
            "type": "null"
          }
        }
      }
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "line_id",
          "billed",
          "payable",
          "fingerprint"
        ]
      }
    },
    "adjustments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/adjustment"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "query_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "query_item_id",
          "addressed_to",
          "text",
          "linked_findings"
        ]
      }
    },
    "rule_executions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "execution_id",
          "rule_id",
          "rule_version",
          "status",
          "detail"
        ],
        "properties": {
          "status": {
            "enum": [
              "PASSED",
              "FAILED",
              "APPLIED",
              "NOT_APPLICABLE",
              "REVIEW",
              "BLOCKED",
              "SKIPPED_BLOCKED",
              "FLAGGED"
            ]
          }
        }
      }
    }
  }
}
